apiVersion: v1
kind: Service
metadata:
  name: qbittorrent
  namespace: media
spec:
  type: LoadBalancer

  loadBalancerIP: 192.168.0.221

  selector:
    app: qbittorrent

  ports:
  {% for port in qbittorrent_service_ports %}
    - name: {{ port.name }}
      port: {{ port.port }}
      targetPort: {{ port.targetPort }}
  {% if port.protocol is defined %}
      protocol: {{ port.protocol }}
  {% endif %}
  {% endfor %}