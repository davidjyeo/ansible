apiVersion: v1
kind: Service

metadata:
  name: plex
  namespace: {{ plex_namespace }}

spec:
  type: LoadBalancer

  loadBalancerIP: {{ plex_loadbalancer_ip }}

  externalTrafficPolicy: Local

  selector:
    app: plex

  ports:
    - name: plex
      port: 32400
      targetPort: 32400
      protocol: TCP